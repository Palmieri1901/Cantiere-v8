# 1. Costruzione del Frontend React dalla root
FROM node:18 AS frontend-builder
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . ./
RUN npm run build

# 2. Immagine finale del Backend Python (FastAPI)
FROM python:3.13-slim
WORKDIR /app

RUN apt-get update && apt-get install -y \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

COPY backend/ /app/

# Assicura che la cartella static esista
RUN mkdir -p /app/static

# Copia automatica sia che l'output sia in build (CRA) o in dist (Vite)
COPY --from=frontend-builder /app/build /tmp/build-output
RUN if [ -d /tmp/build-output ]; then cp -r /tmp/build-output/. /app/static/; fi

COPY --from=frontend-builder /app/dist /tmp/dist-output
RUN if [ -d /tmp/dist-output ]; then cp -r /tmp/dist-output/. /app/static/; fi

EXPOSE 8080
CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8080"]
