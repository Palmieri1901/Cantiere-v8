# --- Fase 1: build React ---
FROM node:20-alpine AS build
WORKDIR /src
COPY frontend/package.json frontend/yarn.lock* ./
RUN yarn install --frozen-lockfile --network-timeout 600000 || yarn install --network-timeout 600000
COPY frontend/ ./
ARG REACT_APP_BACKEND_URL
ARG REACT_APP_APP_DIPENDENTI_HOST
ENV REACT_APP_BACKEND_URL=$REACT_APP_BACKEND_URL
ENV REACT_APP_APP_DIPENDENTI_HOST=$REACT_APP_APP_DIPENDENTI_HOST
ENV GENERATE_SOURCEMAP=false
ENV DISABLE_ESLINT_PLUGIN=true
RUN yarn build

# --- Fase 2: Caddy serve i file statici + HTTPS automatico + proxy /api ---
FROM caddy:2-alpine
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /src/build /srv
